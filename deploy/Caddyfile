# Caddy, API_DOMAIN için Let's Encrypt sertifikasını kendisi alır ve yeniler.
# Alan adının DNS A kaydı bu sunucuyu göstermeli; 80 ve 443 portları açık olmalı.
{$API_DOMAIN} {
	encode zstd gzip

	# Görsel yüklemeleri 5 MB ile sınırlı; biraz pay bırakılır.
	request_body {
		max_size 8MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy api:8080
}
