# Bu dosyayı .env adıyla kopyala ve doldur:  cp .env.example .env
# .env git'e girmez; içindeki şifreleri kimseyle paylaşma.

# ------------------------------------------------------------ zorunlu
# API'nin alan adı. DNS'te A kaydı bu sunucunun IP'sini göstermeli. Uygulamadaki adres: https://<API_DOMAIN>
API_DOMAIN=api.ornek.com
# Veritabanı şifresi (yalnız harf ve rakam):  openssl rand -hex 24
POSTGRES_PASSWORD=
# Giriş token'larını imzalayan anahtar (en az 32 karakter):  openssl rand -hex 32
# Değiştirirsen herkesin oturumu kapanır.
JWT_SIGNING_KEY=

# ------------------------------------------------------------ e-posta (şifre sıfırlama kodu)
# Boş bırakılırsa e-posta gönderilmez, kod yalnız sunucu loguna yazılır.
EMAIL_FROM=no-reply@ornek.com
EMAIL_FROM_NAME=Yakında
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# ------------------------------------------------------------ mağaza sayfaları (/legal/...)
LEGAL_OPERATOR_NAME=Yakında uygulaması
SUPPORT_EMAIL=destek@ornek.com

# ------------------------------------------------------------ paylaşım bağlantısının uygulamada açılması
# Apple Developer → Membership → Team ID ile:  TEAMID.com.emreus.yakinda
APPLE_APP_ID=
ANDROID_PACKAGE=com.emreus.yakinda
# eas credentials -p android → "SHA256 Fingerprint" (AA:BB:CC:...)
ANDROID_SHA256_FINGERPRINT=
# Mağazada yayınlandıktan sonra (paylaşım sayfasındaki butonlar)
IOS_STORE_URL=
ANDROID_STORE_URL=

# ------------------------------------------------------------ isteğe bağlı
# expo.dev → Access tokens ("Enhanced push security" açıksa gerekli)
EXPO_ACCESS_TOKEN=
# Boşsa MediatR log'a lisans uyarısı yazar
MEDIATR_LICENSE_KEY=
