{
  "expo": {
    "name": "Yakında",
    "slug": "yakinda",
    "scheme": "yakinda",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.example.yakinda",
      "supportsTablet": false
    },
    "android": {
      "package": "com.example.yakinda"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#5B3FD9",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki etkinlikleri gösterebilmek ve etkinlik konumunu seçebilmen için konumuna ihtiyacımız var."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafı ve etkinlik görseli seçmek için fotoğraflarına erişim gerekiyor.",
          "cameraPermission": "Profil fotoğrafı ve etkinlik görseli çekmek için kameraya erişim gerekiyor.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "supportEmail": "destek@ornek.com"
    }
  }
}
