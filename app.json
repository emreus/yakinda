{
  "expo": {
    "name": "Yakında",
    "slug": "yakinda",
    "scheme": "yakinda",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.example.yakinda",
      "supportsTablet": false
    },
    "android": {
      "package": "com.example.yakinda"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakınındaki etkinlikleri gösterebilmek ve etkinlik konumunu seçebilmen için konumuna ihtiyacımız var."
        }
      ]
    ]
  }
}
