<Project>
  <!-- Tüm NuGet sürümleri tek yerden yönetilir (Central Package Management). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- CQRS / pipeline -->
    <!-- Not: MediatR 13+ ticari lisanslıdır; yıllık geliri 5M$ altı şirketler için ücretsiz Community lisansı vardır. README'ye bakın. -->
    <PackageVersion Include="MediatR" Version="15.0.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />

    <!-- Veri erişimi -->
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />

    <!-- Cache: FusionCache (L1 bellek + L2 Redis + Redis backplane) -->
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="2.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.7" />

    <!-- API -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>
</Project>
